# Repositorio destino donde se registraran los runners
REPO_URL=https://github.com/TU_USUARIO/TU_REPO

# Token recomendado: Personal Access Token (classic o fine-grained)
# con permisos para gestionar self-hosted runners en el repositorio.
# NO uses el token temporal de la pantalla de "New runner" porque expira rapido.
ACCESS_TOKEN=ghp_reemplazar_por_token_valido

# Etiquetas del runner que podras usar en runs-on
LABELS=self-hosted,linux,x64,docker

# true = runner efimero (se elimina al terminar un job)
# false = runner persistente
EPHEMERAL=false

# true = permite auto-update del runner de GitHub
DISABLE_AUTO_UPDATE=true
